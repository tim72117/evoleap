# Shuttle server 環境變數範本。本機開發用 shell export 或 IDE 設定注入;正式環境由 Cloud Run 注入。

# 監聽埠。平台(Cloud Run)會注入 PORT,有設時覆寫 -addr(本機預設 127.0.0.1:8190)。
PORT=

# 資料庫。正式環境為 Cloud SQL Postgres,經 Unix socket 連線:
#   postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# 留空時使用本機 SQLite 檔案(-db 旗標,預設 shuttle.db)。
DATABASE_URL=

# 登入 cookie 的 JWT 簽章金鑰。本機留空用開發預設值;Cloud Run 上未設定會拒絕啟動。
JWT_SECRET=

# Google 登入(Google Identity Services)的 OAuth 用戶端 ID;留空則不提供 Google 登入。
GOOGLE_OAUTH_CLIENT_ID=

# 管理後台(網頁 /admin,API /api/admin/*)與研發基地的管理員 Email 白名單。沿用 tripace 的做法:
# 沒有獨立的管理員帳號,管理員就是「一般會員 + Email 在這份白名單內」,而且必須用 Google 登入
# (Email 經 Google 驗證;純密碼帳號不算,避免被人搶註冊)。可用逗號分隔多個,比對時忽略大小寫;留空時沒有任何人能進管理後台。
# 研發基地(/studio、/materials、/docs)也用同一份白名單。
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Paddle 訂閱。Webhook 金鑰來自 Paddle 的通知目的地(pdl_ntfset_ 開頭),sandbox 與正式環境各有一把;
# 留空時 POST /api/paddle/webhook 回 503,不接受任何付款事件。
PADDLE_WEBHOOK_SECRET=
# Paddle API key,建立結帳、管理訂閱(要有 customer_portal_session.write 權限)與停止續訂都要用;只放在伺服器,不要放進前端。
PADDLE_API_KEY=
# 前端 Paddle.js 用的 client-side token,可以公開,由 GET /api/plan/plans 提供給前端;留空時收費頁顯示即將開放。
PADDLE_CLIENT_TOKEN=
# production 才連正式環境與正式價格,其他值都是 sandbox;價格 ID 寫在 internal/plans/plans.go。
PADDLE_ENV=sandbox
