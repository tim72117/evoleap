# Shuttle server 環境變數範本。本機開發用 shell export 或 IDE 設定注入;正式環境由 Cloud Run 注入。

# 監聽埠。平台(Cloud Run)會注入 PORT,有設時覆寫 -addr(本機預設 127.0.0.1:8190)。
PORT=

# 資料庫。正式環境為 Cloud SQL Postgres,經 Unix socket 連線:
#   postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# 留空時使用本機 SQLite 檔案(-db 旗標,預設 shuttle.db)。
DATABASE_URL=

# 登入 cookie 的 JWT 簽章金鑰。本機留空用開發預設值;Cloud Run 上未設定會拒絕啟動。
JWT_SECRET=

# Google 登入(Google Identity Services)的 OAuth 用戶端 ID;留空則不提供 Google 登入。
GOOGLE_OAUTH_CLIENT_ID=
