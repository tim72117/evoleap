# 複製為 .env(或 .env.production.local)後填值;.env 不進版控。

# Google Analytics 4 評估 ID(GA4 管理 → 資料串流,格式 G-XXXXXXXXXX)。
# 只在 production build 生效;留空則完全不載入 gtag.js、不發任何請求。
# Docker / CI 以 --build-arg VITE_GA_MEASUREMENT_ID=... 傳入(見根目錄 Dockerfile)。
VITE_GA_MEASUREMENT_ID=

# 旁白語音(npm run voice,只在本機用,不進網站):Google AI Studio 的 Gemini API 金鑰。
# 真正的金鑰寫在 web/.env.local(不進版控),不要寫在這裡。
GEMINI_API_KEY=
