    },
    {
      "on": "claude",
      "ask": "git config user.name; git config user.email",
      "q": "Claude 想要執行這個指令",
      "where": "~/projects/hello",
      "note": "讀出 Git 設定的名字與 email",
      "narration": "接著讀 Git 的名字和 email，一樣只是讀，允許。"
