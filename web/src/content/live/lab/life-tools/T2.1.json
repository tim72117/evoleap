    { "on": "claude", "thinking": true, "ms": 1100 },
    { "on": "claude", "say": "已修正：選到不是圖片的檔案時，會顯示「請選擇圖片檔」，其他功能不變。" },
    { "on": "tool", "site": "lt-life-tools-T2-1-mark-v5" },
    { "on": "tool", "click": "#pick" },
    { "on": "tool", "click": "[data-file=txt]" },
