            { "on": "board", "click": "[data-p=local]", "narration": "要選這一條：在網頁上按選擇圖片，圖片只在你的瀏覽器裡處理。" }
          ]
        },
        {
          "label": "B　在網頁上選擇圖片",
          "target": "board:sel:[data-p=local]",
          "steps": [
            { "on": "board", "click": "[data-p=local]", "narration": "對。在網頁上選檔，圖片只在你的瀏覽器裡處理，交出去的是蓋好浮水印的新檔。" }
          ]
        }
      ],
      "skip": {
        "label": "看示範",
        "steps": [
          { "on": "board", "click": "[data-p=ai]", "narration": "拖進 AI 對話框，檔案內容會送到 AI 服務。" },
          { "on": "board", "click": "[data-p=local]", "narration": "在網頁上選擇圖片，圖片只在你的瀏覽器裡處理。這一課要走的是這條路。" }
        ]
