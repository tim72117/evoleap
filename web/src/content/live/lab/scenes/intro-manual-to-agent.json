  "steps": [
    {
      "wait": 900,
      "chapter": "手寫的年代",
      "narration": "以前想做網站，得先學會寫程式。"
    },
    {
      "write": true,
      "narration": "一個字一個字，慢慢手打。"
    },
    {
      "run": true,
      "narration": "少了一個符號，整個畫面就壞了。"
    },
    {
      "hunt": true,
      "chapter": "找錯",
      "narration": "找一個錯，可能要花上好幾個小時。"
    },
    {
      "patch": true,
      "narration": "改一個字。"
    },
    {
      "run": true,
      "narration": "這裡好了，別的地方又壞了。"
    },
    {
      "hunt": true,
      "narration": "再找一次。"
    },
    {
      "patch": true,
      "narration": "再改一個字。"
    },
    {
      "run": true,
      "narration": "還是不對。"
    },
    {
      "slump": true,
      "narration": "一天、兩天、三天過去了。"
    },
    {
      "call": true,
      "chapter": "請 AI 幫忙",
      "narration": "所以我請 AI 代理人來幫忙。"
    },
    {
      "enter": true,
      "narration": "它來了。"
    },
    {
      "handoff": "幫我做一個網站。",
      "narration": "我只要把需求說出來。"
    },
    {
      "show": "a",
      "narration": "接下來，換 AI 代理人動手。",
      "chapter": "AI 代理人上場"
    },
    {
      "hide": "m"
    },
    {
      "need": "幫我做小森烘焙的一頁式網站，要有菜單和地址。",
      "narration": "你只要把需求說一次。"
    },
    {
      "plan": true,
      "narration": "它先把步驟想好。"
    },
    {
      "ask": "建立 index.html",
      "chapter": "動手之前先問你",
      "narration": "要動你的電腦之前，它會先問你。"
    },
    {
      "allow": false,
      "narration": "你可以拒絕，它就停下來。"
    },
    {
      "ask": "只在「小森烘焙」資料夾裡建立 index.html，不動其他檔案",
      "narration": "它換個方式，再問你一次。"
    },
    {
      "allow": true,
      "narration": "你按下允許，它才開始動手。"
    },
    {
      "build": true,
      "chapter": "它自己做、自己檢查",
      "narration": "接下來它自己寫程式，網站一塊一塊長出來。"
    },
    {
      "check": true,
      "narration": "寫完它自己開瀏覽器檢查，發現少了樣式。"
    },
    {
      "fix": true,
      "narration": "它自己修改，網站換上了顏色與版面。"
    },
    {
      "done": true,
      "chapter": "做完回報給你",
      "narration": "做完回報給你。你只說了需求、按了允許。"
    },
    {
      "wait": 1500
    }
  ]
