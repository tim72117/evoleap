            "if": {
              "is": 10
            },
            "do": [
              {
                "fireworks": true
              }
            ]
          }
        ]
      },
      "place": {
        "landscape": {
          "x": 60,
          "y": 40,
          "w": 1800,
          "h": 840
        },
        "portrait": {
          "x": 40,
          "y": 240,
          "w": 1000,
          "h": 1340
        }
      }
    }
  },
  "steps": [
    {
      "wait": 400,
      "guide": {
        "target": "kid:page",
        "text": "神秘驚喜"
      },
      "chapter": "驚喜在哪裡",
      "narration": "這個網頁藏著一個驚喜，要按到 10 才看得到。我們先偷偷把盒子放到 8。"
    },
    {
      "fill": 8,
      "tap": true,
      "narration": "盒子「按了幾下」，現在是 8。"
    },
    {
      "press": "go",
      "tap": true,
      "narration": "按一下，9。沒有驚喜。"
    },
    {
      "press": "go",
      "narration": "再按一下，10！哇，放煙火了！"
    },
    {
      "wait": 400,
      "guide": {
        "target": "kid:rule:boom",
        "text": "到 10 才放煙火"
