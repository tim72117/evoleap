            {
              "press": "go",
              "ms": 1500
            },
            {
              "press": "go",
              "narration": "1、2、3！條件成立，放煙火！"
            }
          ]
        },
        {
          "label": "按到 5",
          "steps": [
            {
              "fill": 0,
              "narration": "盒子先放回 0。"
            },
            {
              "edit": "boom",
              "is": 5,
              "tap": true,
              "narration": "把條件裡的 10 改成 5。"
            },
            {
              "press": "go",
              "ms": 1500
            },
            {
              "press": "go",
              "ms": 1500
            },
            {
              "press": "go",
              "ms": 1500
            },
            {
              "press": "go",
              "ms": 1500
            },
            {
              "press": "go",
              "narration": "1、2、3、4、5！條件成立，放煙火！"
            }
          ]
        }
      ]
    },
    {
      "checkpoint": "換你換驚喜",
      "sub": "lab/kids/3.4-surprise.json",
