    {
      "on": "phone",
      "ask": "要允許我執行這個指令嗎？",
      "cmd": "npm run fix",
      "narration": "它想執行修正指令，等你允許。"
    },
    {
      "on": "phone",
      "allow": true,
      "narration": "在手機上按允許，辦公室的電腦就繼續做。"
    },
    {
      "on": "phone",
      "tool": "Bash",
      "arg": "npm run fix",
      "result": "已修正",
      "narration": "過一會兒，修正完成。"
    },
    {
      "on": "phone",
      "say": "已修正，再跑一次測試：13 項全部通過。",
      "narration": "Claude 回報，全部通過。"
    },
    {
      "callout": "phone:say",
      "text": "在手機上看進度、回覆、允許，不必回到電腦前",
      "ms": 3600,
      "narration": "進度、回覆、允許要執行的操作，都在手機上完成。"
    },
